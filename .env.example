# Copy to .env locally if needed. Do not commit real secrets.

# Admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Public app host used by mailer URL helpers. Host only, no protocol.
APP_HOST=tdkgroup.com.au

# Contact form recipient. Defaults to info@tdkgroup.com.au when unset.
CONTACT_RECIPIENT_EMAIL=info@tdkgroup.com.au

# Optional SMTP delivery. If SMTP_ADDRESS is blank, local/dev/production boot still works.
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=tdkgroup.com.au
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS=true

# Active Storage. local stores files under Rails storage/; production deploys should mount it persistently.
# For S3, keep the bucket private with Block Public Access ON and Object Ownership set to Bucket owner enforced.
# CloudFront OAC handles public reads; the Rails IAM user handles upload/delete through IAM policy.
ACTIVE_STORAGE_SERVICE=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=

# Optional CloudFront asset host for S3-backed Active Storage delivery.
PUBLIC_UPLOAD_ASSET_HOST=
