<header class="site-header">
  <div class="site-header__inner">
    <%= link_to localized_slug_path("home"), class: "brand-lockup" do %>
      <span class="brand-logo"><%= tdk_logo_tag(class: "brand-logo__image") %></span>
      <span>
        <strong>TDK Group Pty Ltd</strong>
        <small><%= current_locale == "zh" ? "黄金会计师事务所" : "Accounting, Taxation & Advisory" %></small>
      </span>
    <% end %>

    <div class="mobile-header__actions">
      <%= render "shared/mobile_language_switcher" %>

      <details class="mobile-menu">
        <summary aria-label="Open navigation"><span></span><span></span><span></span></summary>
        <nav class="mobile-menu__panel">
          <% header_nav_items.each do |item| %>
            <% if item[:children].present? %>
              <div class="mobile-menu__group">
                <%= link_to page_nav_label(item[:slug]), link_for_cms_slug(item[:slug]), class: "mobile-menu__parent" %>
                <div class="mobile-menu__children">
                  <% item[:children].each do |child| %>
                    <%= link_to page_nav_label(child[:slug]), link_for_cms_slug(child[:slug]) %>
                  <% end %>
                </div>
              </div>
            <% else %>
              <%= link_to page_nav_label(item[:slug]), link_for_cms_slug(item[:slug]) %>
            <% end %>
          <% end %>
          <%= link_to current_locale == "zh" ? "电话 03 9890 4988" : "Call 03 9890 4988", "tel:0398904988" %>
        </nav>
      </details>
    </div>

    <nav class="site-nav">
      <% header_nav_items.each do |item| %>
        <% if item[:children].present? %>
          <div class="site-nav__item site-nav__item--dropdown">
            <%= link_to page_nav_label(item[:slug]), link_for_cms_slug(item[:slug]), class: ("is-active" if nav_item_active?(item)) %>
            <div class="site-nav__dropdown">
              <% item[:children].each do |child| %>
                <%= link_to page_nav_label(child[:slug]), link_for_cms_slug(child[:slug]), class: ("is-active" if @page&.slug == child[:slug]) %>
              <% end %>
            </div>
          </div>
        <% else %>
          <%= link_to page_nav_label(item[:slug]), link_for_cms_slug(item[:slug]), class: ("is-active" if nav_item_active?(item)) %>
        <% end %>
      <% end %>
    </nav>

    <div class="site-header__actions">
      <%= link_to "03 9890 4988", "tel:0398904988", class: "header-phone" %>
      <%= render "shared/language_selector" %>
      <%= link_to current_locale == "zh" ? "预约咨询" : "Book a consult", localized_slug_path("contact-us"), class: "header-cta" %>
    </div>
  </div>
</header>
