        <span>
          <strong>TDK Group Pty Ltd</strong>
          <small>Accounting, taxation and advisory services</small>
        </span>
      </div>
      <p>1/550 Whitehorse Rd, Surrey Hills, VIC 3127</p>
      <p><a href="tel:0398904988">03 9890 4988</a> · <a href="mailto:info@tdkgroup.com.au">info@tdkgroup.com.au</a></p>
