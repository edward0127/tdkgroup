<footer class="site-footer">
  <div class="site-footer__inner">
    <section class="site-footer__brand">
      <div class="brand-lockup brand-lockup--footer">
        <span class="brand-logo brand-logo--footer"><%= tdk_logo_tag(class: "brand-logo__image") %></span>
        <span>
          <strong>TDK Group Pty Ltd</strong>
          <small><%= current_locale == "zh" ? "会计、税务与商业咨询服务" : "Accounting, taxation and advisory services" %></small>
        </span>
      </div>
      <p class="footer-description">
        <%= current_locale == "zh" ? "为个人、企业与投资者提供清晰、务实、双语的会计和税务支持。" : "Clear, practical accounting, taxation and advisory support for individuals, businesses and investors." %>
      </p>
      <%= render "shared/language_selector" %>
    </section>

    <% footer_link_groups.each do |group| %>
      <section class="site-footer__panel">
        <h2><%= group.fetch(:title) %></h2>
        <nav class="site-footer__links" aria-label="<%= group.fetch(:title) %>">
          <% group.fetch(:links).each do |link| %>
            <% if link[:slug].present? %>
              <%= link_to link[:label].presence || page_nav_label(link[:slug]), link_for_cms_slug(link[:slug]) %>
            <% else %>
              <span><%= link.fetch(:label) %></span>
            <% end %>
          <% end %>
        </nav>
      </section>
    <% end %>
  </div>
  <div class="site-footer__base">
    <span>© TDK Group Pty Ltd 2024</span>
    <span><%= current_locale == "zh" ? "CPA 专业会计与咨询服务" : "CPA practice and professional advisory services" %></span>
  </div>
</footer>
