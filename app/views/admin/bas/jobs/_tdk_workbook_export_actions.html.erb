<% if workbook.present? %>
  <% if workbook.export_status == "stale" %>
    <p class="tdk-export-stale-note">Bank statement changed. Prepare a new Excel download to include the latest edits.</p>
  <% end %>

  <div class="tdk-export-actions">
    <% if workbook.export_ready? %>
      <%= link_to "Download Excel",
            download_admin_bas_job_tdk_workbook_path(@job, workbook),
            class: "btn-primary",
            data: { turbo: false } %>
    <% elsif workbook.export_in_progress? %>
      <span class="btn-secondary is-disabled tdk-export-disabled" aria-disabled="true">
        <span class="tdk-status-spinner" aria-hidden="true"></span>
        <span>Preparing Excel download...</span>
      </span>
    <% else %>
      <%= button_to "Prepare Excel download",
            prepare_download_admin_bas_job_tdk_workbook_path(@job, workbook),
            method: :post,
            class: "btn-secondary",
            form: bas_submit_guard_form("Preparing Excel download") %>
    <% end %>
  </div>
<% else %>
  <span class="admin-muted">Prepare/download available after processing succeeds.</span>
<% end %>
