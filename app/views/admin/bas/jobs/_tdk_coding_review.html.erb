<% coding_form_id = dom_id(run, :coding_review_form) %>
<% coding_columns = tdk_coding_table_columns %>
<section id="tdk-coding-review"
  class="bas-panel-block tdk-workbook-review-card tdk-coding-review-card"
  data-controller="anchor-scroll tdk-resizable-table"
  data-tdk-resizable-table-storage-key-value="<%= tdk_coding_column_width_storage_key(run) %>">
  <div class="tdk-coding-review-heading">
    <div>
      <h2>Category &amp; GST suggestions</h2>
      <p class="admin-muted"><%= tdk_coding_row_range_label %></p>
    </div>
    <div class="tdk-coding-review-heading__actions">
      <%= render "tdk_coding_pagination",
            location: :top,
            id_suffix: "top",
            aria_label: "Category and GST coding top pagination" %>
      <button type="button" class="btn-secondary tdk-workbook-reset-widths-button" data-action="click->tdk-resizable-table#resetWidths">Reset column widths</button>
      <button type="submit" form="<%= coding_form_id %>" class="btn-primary" data-submit-guard-loading-text="Saving review">Save reviewed rows</button>
    </div>
  </div>

  <div class="tdk-coding-summary" aria-label="Coding review summary">
    <div><span>Total rows</span><strong><%= run.row_count %></strong></div>
    <div><span>Suggestions</span><strong><%= run.suggestion_count %></strong></div>
    <div class="is-warning"><span>Rows needing review</span><strong><%= @tdk_coding_filter_counts.fetch("needs_review", 0) %></strong></div>
    <div><span>Category review</span><strong><%= @tdk_coding_filter_counts.fetch("category_review", 0) %></strong></div>
    <div><span>GST review</span><strong><%= @tdk_coding_filter_counts.fetch("gst_review", 0) %></strong></div>
    <div class="is-reviewed"><span>Reviewed</span><strong><%= run.reviewed_count %></strong></div>
  </div>

  <% review_total = tdk_coding_review_report_value(:total_review_rows, @tdk_coding_filter_counts.fetch("needs_review", 0)).to_i %>
  <section class="tdk-coding-review-report" aria-labelledby="tdk-coding-review-report-title">
    <div class="tdk-coding-review-report__intro">
      <div>
        <span class="tdk-coding-review-report__eyebrow">Review report</span>
        <h3 id="tdk-coding-review-report-title">Why <%= review_total %> <%= "row".pluralize(review_total) %> need confirmation</h3>
      </div>
      <div>
        <p>A highlight means the available prior-quarter evidence or GST support is not strong enough for automatic acceptance. It does <strong>not</strong> mean the suggestion is known to differ from a verified current-quarter answer—no such answer is uploaded in this workflow.</p>
        <nav class="tdk-coding-review-report__filter-links" aria-label="Open field review filters">
          <%= link_to admin_bas_job_path(@job, tdk_coding_filter_link_params("category_review")) do %>
            Open Category review <strong><%= tdk_coding_review_field_count(:category) %></strong>
          <% end %>
          <%= link_to admin_bas_job_path(@job, tdk_coding_filter_link_params("gst_review")) do %>
            Open GST review <strong><%= tdk_coding_review_field_count(:gst) %></strong>
          <% end %>
        </nav>
      </div>
    </div>

    <div class="tdk-coding-review-report__field-split" aria-label="Review fields">
      <div class="tdk-coding-review-report__field-stat">
        <span>Category only</span><strong><%= tdk_coding_review_combination_count(:category_only) %></strong>
      </div>
      <div class="tdk-coding-review-report__field-stat">
        <span>GST only</span><strong><%= tdk_coding_review_combination_count(:gst_only) %></strong>
      </div>
      <div class="tdk-coding-review-report__field-stat">
        <span>Both fields</span><strong><%= tdk_coding_review_combination_count(:both) %></strong>
      </div>
    </div>

    <% if tdk_coding_review_reason_groups.any? %>
      <div class="tdk-coding-review-report__reasons" aria-label="Reasons rows need review">
        <% tdk_coding_review_reason_groups.each do |group| %>
          <article class="tdk-coding-review-report__reason">
            <div>
              <strong><%= tdk_coding_review_reason_group_title(group) %></strong>
              <span><%= report_value(group, :count, 0).to_i %> <%= "row".pluralize(report_value(group, :count, 0).to_i) %></span>
            </div>
            <p><%= tdk_coding_review_reason_group_description(group) %></p>
          </article>
        <% end %>
      </div>
    <% end %>

    <p class="tdk-coding-review-notice"><strong>What to do:</strong> check each highlighted field against the transaction and any current invoice, edit it if needed, then mark the row Reviewed. Suggestions are not final tax advice.</p>
  </section>

  <nav class="tdk-coding-filters" aria-label="Filter Category and GST suggestions">
    <% tdk_coding_filter_options.each do |label, filter| %>
      <%= link_to admin_bas_job_path(@job, tdk_coding_filter_link_params(filter)),
            class: [ "tdk-coding-filter", ("is-active" if @tdk_coding_filter == filter) ],
            aria: (@tdk_coding_filter == filter ? { current: "page" } : {}) do %>
        <span><%= label %></span><strong><%= @tdk_coding_filter_counts.fetch(filter, 0) %></strong>
      <% end %>
    <% end %>
  </nav>

  <% if @tdk_row_codings.any? %>
    <div class="tdk-workbook-table-scrollbar-top"
         data-tdk-resizable-table-target="topScroll"
         data-action="scroll->tdk-resizable-table#scrollTableFromTop"
         hidden>
      <div class="tdk-workbook-table-scrollbar-top__inner"
           data-tdk-resizable-table-target="topScrollInner"></div>
    </div>
  <% end %>

  <%= form_with url: update_rows_admin_bas_job_tdk_coding_run_path(@job, run),
        method: :patch,
        id: coding_form_id,
        class: "admin-form admin-form--wide tdk-coding-review-form",
        data: bas_submit_guard_data("Saving review") do %>
    <%= hidden_field_tag :coding_filter, @tdk_coding_filter %>
    <%= hidden_field_tag :coding_page, @tdk_coding_page %>
    <%= hidden_field_tag :coding_per_page, @tdk_coding_per_page %>
    <%= hidden_field_tag :coding_sort, @tdk_coding_sort if @tdk_coding_sort.present? %>
    <%= hidden_field_tag :coding_direction, @tdk_coding_direction if @tdk_coding_direction.present? %>

    <% if @tdk_row_codings.any? %>
      <div class="tdk-workbook-table-wrap tdk-coding-table-wrap"
           data-tdk-resizable-table-target="tableWrap"
           data-action="scroll->tdk-resizable-table#scrollTopFromTable">
        <table class="admin-table tdk-coding-table" data-tdk-resizable-table-target="table">
          <colgroup>
            <% coding_columns.each do |column| %>
              <%= tag.col class: column.fetch(:class_name),
                    data: {
                      tdk_resizable_table_target: "column",
                      column_key: column.fetch(:key),
                      default_width: column.fetch(:default_width),
                      min_width: column.fetch(:min_width)
                    } %>
            <% end %>
          </colgroup>
          <thead>
            <tr>
              <% coding_columns.each do |column| %>
                <%= tag.th class: column.fetch(:class_name), data: { column_key: column.fetch(:key) } do %>
                  <%= link_to admin_bas_job_path(@job, tdk_coding_sort_link_params(column)),
                        class: "tdk-workbook-sort-link",
                        title: "Sort by #{column.fetch(:label)}",
                        aria: { label: "Sort by #{column.fetch(:label)}" } do %>
                    <span><%= column.fetch(:label) %></span>
                    <span class="tdk-workbook-sort-indicator"><%= tdk_coding_sort_indicator(column) %></span>
                  <% end %>
                  <%= tag.span class: "tdk-workbook-column-resize-handle",
                        data: {
                          tdk_resizable_table_target: "handle",
                          column_key: column.fetch(:key),
                          action: "pointerdown->tdk-resizable-table#startResize click->tdk-resizable-table#handleClick"
                        },
                        aria: { label: "Resize #{column.fetch(:label)} column" },
                        role: "separator" %>
                <% end %>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% @tdk_row_codings.each do |coding| %>
              <% row = coding.workbook_row %>
              <% category_reason_id = "tdk-coding-category-reason-#{coding.id}" if coding.category_review_required? %>
              <% gst_reason_id = "tdk-coding-gst-reason-#{coding.id}" if coding.gst_review_required? %>
              <%= tag.tr class: ("tdk-coding-row--needs-review" if coding.review_required?), data: { source_row_number: row.source_row_number } do %>
                <td class="tdk-coding-readonly"><%= tdk_workbook_display_value(row.row_data["Date"]) %></td>
                <td class="tdk-coding-description"><%= tdk_workbook_display_value(row.row_data["Description"]) %></td>
                <td class="tdk-coding-amount"><%= tdk_workbook_amount_input_value(row.row_data["Amount"]) %></td>
                <td>
                  <%= text_field_tag "codings[#{coding.id}][category]", tdk_coding_category_value(coding),
                        class: tdk_coding_field_classes(coding, :category),
                        aria: { label: "Category for source row #{row.source_row_number || row.position}", describedby: category_reason_id }.compact %>
                  <% if coding.category_review_required %>
                    <span class="tdk-coding-field-warning">Category needs review</span>
                    <span id="<%= category_reason_id %>" class="tdk-coding-field-reason"><strong>Why:</strong> <%= tdk_coding_field_review_reason(coding, :category) %></span>
                  <% end %>
                </td>
                <td>
                  <%= text_field_tag "codings[#{coding.id}][gst]", tdk_coding_gst_value(coding),
                        class: tdk_coding_field_classes(coding, :gst),
                        inputmode: "decimal",
                        pattern: tdk_workbook_amount_input_pattern,
                        title: tdk_workbook_amount_input_title,
                        aria: { label: "GST for source row #{row.source_row_number || row.position}", describedby: gst_reason_id }.compact %>
                  <% if coding.gst_review_required %>
                    <span class="tdk-coding-field-warning">GST needs review</span>
                    <span id="<%= gst_reason_id %>" class="tdk-coding-field-reason"><strong>Why:</strong> <%= tdk_coding_field_review_reason(coding, :gst) %></span>
                  <% end %>
                </td>
                <td class="tdk-coding-provenance">
                  <strong class="tdk-coding-provenance__label">Evidence used</strong>
                  <div><span class="tdk-coding-source-badge <%= tdk_coding_source_class(coding.category_source, coding: coding, field: :category) %>">Category: <%= tdk_coding_source_label(coding.category_source, coding: coding, field: :category) %></span><small><%= tdk_coding_confidence_label(coding.category_confidence) %></small></div>
                  <div><span class="tdk-coding-source-badge <%= tdk_coding_source_class(coding.gst_source, coding: coding, field: :gst) %>">GST: <%= tdk_coding_source_label(coding.gst_source, coding: coding, field: :gst) %></span><small><%= tdk_coding_confidence_label(coding.gst_confidence) %></small></div>
                  <% if (evidence_label = tdk_coding_reference_evidence_label(coding)).present? %>
                    <p class="tdk-coding-reference-evidence"><%= evidence_label %></p>
                    <% if (reference_example = tdk_coding_reference_example(coding)).present? %><p class="tdk-coding-reference-example">Representative example: <q><%= reference_example %></q></p><% end %>
                  <% elsif coding.reference_source_row_number.present? %>
                    <p>Matched reference file row <%= coding.reference_source_row_number %></p>
                  <% end %>
                  <% if coding.explanation.present? %><p><%= coding.explanation %></p><% end %>
                  <% if tdk_coding_information_codes(coding).any? %><p class="tdk-coding-information-codes"><%= tdk_coding_information_codes(coding).join(" · ") %></p><% end %>
                  <% if coding.review_required? && tdk_coding_warning_labels(coding).any? %><p class="tdk-coding-review-signals"><strong>Review signals:</strong> <span class="tdk-coding-warning-codes"><%= tdk_coding_warning_labels(coding).join(" · ") %></span></p><% end %>
                  <% if coding.review_required? %><p class="tdk-coding-next-action"><strong>Next action:</strong> <%= tdk_coding_review_next_action(coding) %></p><% end %>
                </td>
                <td class="tdk-coding-review-control">
                  <%= hidden_field_tag "codings[#{coding.id}][reviewed]", "0" %>
                  <label><%= check_box_tag "codings[#{coding.id}][reviewed]", "1", coding.reviewed? %><span>Reviewed</span></label>
                  <small><%= coding.review_status.humanize %></small>
                </td>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="tdk-coding-empty-state"><strong>No rows match this filter.</strong><p>Choose another filter to continue reviewing suggestions.</p></div>
    <% end %>
  <% end %>

  <div class="tdk-coding-review-footer">
    <div class="admin-muted"><%= tdk_coding_row_range_label %></div>
    <%= render "tdk_coding_pagination",
          location: :bottom,
          id_suffix: "bottom",
          aria_label: "Category and GST coding bottom pagination" %>
    <div class="tdk-workbook-save-action"><button type="submit" form="<%= coding_form_id %>" class="btn-primary" data-submit-guard-loading-text="Saving review">Save reviewed rows</button></div>
  </div>
</section>
