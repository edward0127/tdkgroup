<section class="tdk-workflow-panel tdk-upload-card">
  <div class="admin-panel-heading">
    <div>
      <h2>Bank statement upload</h2>
      <p class="admin-muted">Upload a bank statement Excel, CSV or PDF for review. Readable PDFs are processed directly; scanned PDFs can be processed when local OCR is available. Code Category/GST in the table, or download the latest Excel for bulk edits and upload it again when ready.</p>
    </div>
  </div>

  <div class="tdk-statement-action-row">
    <%= form_with url: admin_bas_job_tdk_workbooks_path(@job),
          scope: :tdk_workbook,
          class: "admin-form tdk-upload-form",
          multipart: true,
          data: bas_submit_guard_data("Queueing bank statement upload") do |form| %>
      <div class="field tdk-upload-file-field">
        <%= form.label :file, "Bank statement Excel, CSV or PDF file" %>
        <%= form.file_field :file,
              accept: ".xlsx,.csv,.pdf,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv,application/csv,application/vnd.ms-excel,application/pdf",
              required: true %>
      </div>
      <button type="submit" class="btn-primary" data-submit-guard-loading-text="Queueing bank statement upload">Upload statement</button>
    <% end %>

    <div class="tdk-export-action-slot" data-tdk-workbook-status-target="downloadAction">
      <%= render "tdk_workbook_export_actions", workbook: @active_tdk_workbook %>
    </div>
  </div>
</section>
