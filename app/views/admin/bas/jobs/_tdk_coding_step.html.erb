<section id="tdk-coding-step" class="admin-card-panel bas-workspace-section tdk-workflow-card tdk-coding-step">
  <div class="admin-panel-heading tdk-coding-step__heading">
    <div>
      <h2>Step 2 — Category &amp; GST coding review</h2>
      <p class="admin-muted">Use the previous quarter as coding history, then review every rule-based or uncertain suggestion before preparing BAS figures.</p>
    </div>
    <%= link_to "Back to bank statement", admin_bas_job_path(@job, tdk_step: "statement"), class: "btn-secondary" %>
  </div>

  <div class="tdk-workflow-grid tdk-coding-setup-grid"
    <% if @latest_tdk_coding_run.present? %>
      data-controller="tdk-coding-status"
      data-tdk-coding-status-url-value="<%= status_admin_bas_job_tdk_coding_run_path(@job, @latest_tdk_coding_run) %>"
      data-tdk-coding-status-initial-status-value="<%= @latest_tdk_coding_run.status %>"
      data-tdk-coding-status-rendered-active-run-id-value="<%= @active_tdk_coding_run&.id %>"
      data-tdk-coding-status-rendered-active-run-version-value="<%= @active_tdk_coding_run&.version_number %>"
      data-tdk-coding-status-poll-interval-value="3000"
    <% end %>>
    <section class="tdk-workflow-panel tdk-coding-reference-card">
      <div class="admin-panel-heading">
        <div>
          <h2>Prior-quarter coding source</h2>
          <p class="admin-muted">Upload the client’s previous-quarter XLSX or CSV containing Description, Category, GST and Amount (or Debit/Credit).</p>
        </div>
      </div>

      <p class="tdk-coding-reference-note">This file is used only as matching history. It will not replace the current bank statement.</p>
      <%= form_with url: admin_bas_job_tdk_coding_runs_path(@job),
            scope: :tdk_coding_run,
            class: "tdk-coding-reference-form",
            multipart: true,
            data: bas_submit_guard_data("Uploading reference") do |form| %>
        <div class="admin-field">
          <%= form.label :reference_file, "Previous-quarter Excel or CSV file" %>
          <%= form.file_field :reference_file,
                accept: ".xlsx,.csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv,application/csv,application/vnd.ms-excel",
                required: true,
                disabled: @job.locked? %>
          <small class="admin-muted">XLSX or CSV, maximum 25 MB.</small>
        </div>
        <%= form.submit @latest_tdk_coding_run.present? ? "Replace reference & re-run" : "Upload & generate suggestions",
              class: "btn-primary",
              disabled: @job.locked?,
              data: { submit_guard_loading_text: "Uploading reference" } %>
      <% end %>
      <p class="admin-muted tdk-coding-target-note">Current statement: v<%= @active_tdk_workbook.version_number %> — <%= @active_tdk_workbook.source_filename %></p>
    </section>

    <section class="tdk-workflow-panel tdk-coding-status-card">
      <div class="admin-panel-heading">
        <div>
          <h2>Coding status</h2>
          <p class="admin-muted">Latest reference processing and the review results currently used below.</p>
        </div>
      </div>

      <% if @latest_tdk_coding_run.present? %>
        <div class="tdk-status-line">
          <span class="tdk-status-pill <%= tdk_workbook_status_class(@latest_tdk_coding_run.status) %>"
            data-tdk-coding-status-target="statusBadge"><%= @latest_tdk_coding_run.status.humanize %></span>
          <span class="tdk-status-spinner <%= "is-empty" unless @latest_tdk_coding_run.status.in?(%w[queued processing]) %>"
            data-tdk-coding-status-target="spinner" aria-hidden="true"></span>
          <strong data-tdk-coding-status-target="sourceFilename"><%= @latest_tdk_coding_run.source_filename %></strong>
        </div>
        <dl class="tdk-status-details tdk-status-details--active tdk-coding-status-details">
          <div><dt>Latest version</dt><dd data-tdk-coding-status-target="version">v<%= @latest_tdk_coding_run.version_number %></dd></div>
          <div><dt>Reference rows</dt><dd data-tdk-coding-status-target="referenceRows"><%= @latest_tdk_coding_run.reference_row_count %></dd></div>
          <div><dt>Suggestions</dt><dd data-tdk-coding-status-target="suggestions"><%= @latest_tdk_coding_run.suggestion_count %></dd></div>
          <div><dt>Needs review</dt><dd data-tdk-coding-status-target="warnings"><%= @latest_tdk_coding_run.warning_count %></dd></div>
          <div><dt>Reviewed</dt><dd data-tdk-coding-status-target="reviewed"><%= @latest_tdk_coding_run.reviewed_count %></dd></div>
        </dl>
        <div class="tdk-status-errors <%= "is-empty" if @latest_tdk_coding_run.processing_errors.empty? %>"
          data-tdk-coding-status-target="errors">
          <% if @latest_tdk_coding_run.processing_errors.any? %>
            <strong><%= @latest_tdk_coding_run.needs_mapping? ? "Column mapping required" : "Processing errors" %></strong>
            <ul><% @latest_tdk_coding_run.processing_errors.each do |error| %><li><%= error %></li><% end %></ul>
          <% end %>
        </div>
        <% if @active_tdk_coding_run.present? && @active_tdk_coding_run.id != @latest_tdk_coding_run.id %>
          <p class="tdk-status-note">The last successful coding review remains visible while this reference is resolved.</p>
        <% end %>
      <% else %>
        <p class="admin-muted">No prior-quarter reference uploaded yet. Upload one to generate suggestions.</p>
      <% end %>
    </section>
  </div>

  <% if @latest_tdk_coding_run&.needs_mapping? %>
    <%= render "tdk_coding_mapping", run: @latest_tdk_coding_run %>
  <% end %>

  <% if @active_tdk_coding_run.present? %>
    <%= render "tdk_coding_review", run: @active_tdk_coding_run %>
  <% elsif @latest_tdk_coding_run&.status.in?(%w[queued processing]) %>
    <div class="tdk-coding-empty-state" role="status">
      <span class="tdk-status-spinner" aria-hidden="true"></span>
      <div><strong>Generating Category &amp; GST suggestions</strong><p>Results will appear automatically when processing finishes.</p></div>
    </div>
  <% end %>
</section>
