<% workbook = @latest_tdk_workbook_operation %>
<% detection = tdk_column_detection(workbook) %>
<% columns = tdk_column_detection_columns(workbook) %>
<% preview_rows = Array(detection["preview_rows"]).select { |row| row.is_a?(Hash) }.first(5) %>

<section class="tdk-column-mapping-card" id="tdk-column-mapping">
  <div class="admin-panel-heading tdk-column-mapping-heading">
    <div>
      <p class="eyebrow">Action required</p>
      <h2>Confirm bank statement columns</h2>
      <p class="admin-muted">We could not identify every required column with enough confidence. Check the suggested mapping below, then continue processing.</p>
    </div>
    <span class="tdk-status-pill is-warning">Needs mapping</span>
  </div>

  <% if @active_tdk_workbook.present? %>
    <p class="tdk-column-mapping-active-note">The current table from <strong><%= @active_tdk_workbook.source_filename %></strong> remains active. It will only be replaced after this upload processes successfully.</p>
  <% else %>
    <p class="tdk-column-mapping-active-note">No table will become active until this mapping is confirmed and processing succeeds.</p>
  <% end %>

  <% if columns.any? %>
    <%= form_with url: confirm_mapping_admin_bas_job_tdk_workbook_path(@job, workbook),
          method: :patch,
          scope: :column_mapping,
          class: "admin-form tdk-column-mapping-form",
          data: bas_submit_guard_data("Continuing processing") do |form| %>
      <%= form.hidden_field :header_row_number, value: detection["header_row_number"] %>
      <%= form.hidden_field :data_start_row, value: detection["data_start_row"] %>

      <div class="tdk-column-mapping-guidance">
        <strong>Required mapping</strong>
        <span>Choose one Date, one Description, and either one Amount or one Debit and/or one Credit column. Balance is optional.</span>
      </div>

      <div class="admin-table-wrap tdk-column-mapping-table-wrap">
        <table class="admin-table tdk-column-mapping-table">
          <thead>
            <tr>
              <th>Source column</th>
              <th>Sample values</th>
              <th>Use as</th>
            </tr>
          </thead>
          <tbody>
            <% columns.each do |column| %>
              <% index = column["index"].to_s %>
              <% samples = tdk_column_mapping_samples(column) %>
              <tr>
                <td>
                  <strong><%= tdk_column_mapping_source_label(column) %></strong>
                </td>
                <td>
                  <% if samples.any? %>
                    <span class="tdk-column-mapping-samples"><%= samples.map(&:to_s).join(" · ") %></span>
                  <% else %>
                    <span class="admin-muted">No populated sample</span>
                  <% end %>
                </td>
                <td>
                  <%= select_tag "column_mapping[columns][#{index}]",
                        options_for_select(
                          tdk_column_mapping_role_options,
                          tdk_column_mapping_suggested_role(detection, column, workbook: workbook)
                        ),
                        id: "column_mapping_columns_#{index}",
                        class: "tdk-column-mapping-select",
                        aria: { label: "Map #{tdk_column_mapping_source_label(column)}" } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if preview_rows.any? %>
        <div class="tdk-column-preview">
          <h3>Source preview</h3>
          <p class="admin-muted">Use these original rows to check the selected column meanings.</p>
          <div class="admin-table-wrap tdk-column-preview-table-wrap">
            <table class="admin-table tdk-column-preview-table">
              <thead>
                <tr>
                  <th>Row</th>
                  <% columns.each do |column| %>
                    <th><%= tdk_column_mapping_source_label(column) %></th>
                  <% end %>
                </tr>
              </thead>
              <tbody>
                <% preview_rows.each do |preview_row| %>
                  <% values = Array(preview_row["values"]) %>
                  <tr>
                    <td><%= preview_row["row_number"] %></td>
                    <% columns.each_with_index do |_column, column_offset| %>
                      <td><%= values[column_offset] %></td>
                    <% end %>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>

      <% if @job.locked? %>
        <p class="tdk-column-mapping-locked">This BAS job is locked. Unlock it before confirming the column mapping.</p>
      <% else %>
        <div class="tdk-column-mapping-actions">
          <button type="submit" class="btn-primary" data-submit-guard-loading-text="Continuing processing">Confirm mapping and continue processing</button>
        </div>
      <% end %>
    <% end %>
  <% else %>
    <div class="tdk-status-errors">
      <strong>Column preview unavailable</strong>
      <p>Please upload the bank statement again so its columns can be reviewed.</p>
    </div>
  <% end %>
</section>
