<% adjustment_form_url = @adjustment.persisted? ? admin_bas_job_adjustment_path(@job, @adjustment) : admin_bas_job_adjustments_path(@job) %>

<%= form_with model: @adjustment, url: adjustment_form_url, class: "admin-form", data: bas_submit_guard_data("Saving adjustment") do |form| %>
  <% if @adjustment.errors.any? %>
    <div class="form-errors">
      <h2><%= pluralize(@adjustment.errors.count, "error") %> prevented this adjustment from being saved</h2>
      <ul>
        <% @adjustment.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="admin-form-grid">
    <div class="field">
      <%= form.label :adjustment_type %>
      <%= form.select :adjustment_type, BasAdjustment::ADJUSTMENT_TYPE_VALUES.map { |value| [ value.humanize, value ] } %>
    </div>
    <div class="field">
      <%= form.label :label %>
      <%= form.text_field :label %>
    </div>
    <div class="field">
      <%= form.label :amount %>
      <%= form.text_field :amount, inputmode: "decimal" %>
    </div>
  </div>

  <div class="field">
    <%= form.label :reason %>
    <%= form.text_area :reason, rows: 4 %>
  </div>

  <button type="submit" class="btn-primary" data-submit-guard-loading-text="Saving adjustment">Save adjustment</button>
<% end %>
