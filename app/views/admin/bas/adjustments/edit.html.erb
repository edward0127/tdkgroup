<section class="admin-page-heading">
  <div>
    <p class="eyebrow">Edit BAS adjustment</p>
    <h1><%= @job.bas_client.display_name %></h1>
    <p><%= @job.period_label %></p>
  </div>
  <div class="admin-actions">
    <%= link_to "Adjustments", admin_bas_job_adjustments_path(@job), class: "btn-secondary" %>
    <%= link_to "Report review", admin_bas_job_report_path(@job), class: "btn-secondary" %>
  </div>
</section>

<section class="admin-card-panel">
  <h2>Adjustment details</h2>
  <%= render "form" %>
</section>
