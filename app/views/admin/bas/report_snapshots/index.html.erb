<section class="admin-page-heading">
  <div>
    <p class="eyebrow">BAS report snapshots</p>
    <h1><%= @job.bas_client.display_name %></h1>
    <p><%= @job.period_label %></p>
  </div>
  <div class="admin-actions">
    <% unless @job.locked? %>
      <%= button_to "Generate draft", admin_bas_job_report_snapshots_path(@job), method: :post, class: "btn-primary" %>
    <% end %>
    <%= link_to "Report review", admin_bas_job_report_path(@job), class: "btn-secondary" %>
    <%= link_to "Back to job", admin_bas_job_path(@job), class: "btn-secondary" %>
  </div>
</section>

<section class="admin-card-panel">
  <h2>Snapshots</h2>
  <% if @snapshots.any? %>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Status</th>
            <th>Generated</th>
            <th>Generated by</th>
            <th>Blockers</th>
            <th>Approved</th>
            <th>Locked</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @snapshots.each do |snapshot| %>
            <tr>
              <td><%= snapshot.status.humanize %></td>
              <td><%= snapshot.generated_at ? l(snapshot.generated_at, format: :short) : "Not recorded" %></td>
              <td><%= snapshot.generated_by.presence || "Not recorded" %></td>
              <td><%= snapshot.validation_errors.size %></td>
              <td><%= snapshot.approved_at ? l(snapshot.approved_at, format: :short) : "No" %></td>
              <td><%= snapshot.locked_at ? l(snapshot.locked_at, format: :short) : "No" %></td>
              <td><%= link_to "Open", admin_bas_job_report_snapshot_path(@job, snapshot), class: "text-link" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="admin-muted">No report snapshots yet.</p>
  <% end %>
</section>
