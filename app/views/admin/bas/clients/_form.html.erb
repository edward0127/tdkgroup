<% if client.errors.any? %>
  <div class="form-errors">
    <ul>
      <% client.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<% client_form_url = client.persisted? ? admin_bas_client_path(client) : admin_bas_clients_path %>

<%= form_with model: client, url: client_form_url, class: "admin-form", data: bas_submit_guard_data("Saving client") do |form| %>
  <section class="admin-card-panel">
    <h2>Client details</h2>
    <div class="admin-form-grid">
      <div class="field">
        <%= form.label :legal_name %>
        <%= form.text_field :legal_name, required: true, placeholder: "Acme Test Pty Ltd" %>
      </div>
      <div class="field">
        <%= form.label :trading_name %>
        <%= form.text_field :trading_name, placeholder: "Acme Test" %>
        <p class="admin-muted">Optional. Leave blank if same as legal name.</p>
      </div>
      <div class="field">
        <%= form.label :abn, "ABN" %>
        <%= form.text_field :abn, placeholder: "12 345 678 901" %>
      </div>
      <div class="field">
        <%= form.label :contact_name %>
        <%= form.text_field :contact_name, placeholder: "Accounts contact" %>
      </div>
      <div class="field">
        <%= form.label :contact_email %>
        <%= form.email_field :contact_email, placeholder: "accounts@example.com" %>
      </div>
      <div class="field">
        <%= form.label :contact_phone %>
        <%= form.telephone_field :contact_phone %>
      </div>
    </div>
  </section>

  <section class="admin-card-panel">
    <h2>BAS defaults</h2>
    <div class="admin-form-grid">
      <div class="field">
        <%= form.label :default_gst_basis, "Default GST basis" %>
        <%= form.select :default_gst_basis, BasClient::GST_BASIS_VALUES.map { |value| [ value.humanize, value ] } %>
      </div>
      <div class="field">
        <%= form.label :reporting_frequency %>
        <%= form.select :reporting_frequency, BasClient::REPORTING_FREQUENCY_VALUES.map { |value| [ value.humanize, value ] } %>
      </div>
      <div class="field">
        <%= form.label :default_reporting_method %>
        <%= form.select :default_reporting_method, BasClient::REPORTING_METHOD_VALUES.map { |value| [ value.humanize, value ] } %>
      </div>
      <label class="checkbox-field">
        <%= form.check_box :archived %>
        <span>Archived</span>
      </label>
    </div>
    <div class="field">
      <%= form.label :notes, "Notes / internal notes" %>
      <%= form.text_area :notes, rows: 5, placeholder: "Internal BAS notes for this client" %>
    </div>
  </section>

  <div class="admin-submit-row">
    <button type="submit" class="btn-primary" data-submit-guard-loading-text="Saving client">Save client</button>
  </div>
<% end %>
