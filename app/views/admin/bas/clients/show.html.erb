<section class="admin-page-heading">
  <div>
    <p class="eyebrow">BAS client</p>
    <h1><%= bas_client_heading_name(@client) %></h1>
    <%= bas_client_heading_metadata(@client, include_status: true) %>
  </div>
  <div class="admin-actions">
    <%= link_to "Edit client", edit_admin_bas_client_path(@client), class: "btn-primary" %>
    <%= link_to "New TDK BAS job for this client", new_admin_bas_job_path(bas_client_id: @client.id, workflow_type: "tdk_group"), class: "btn-secondary" %>
    <%= link_to "New standard BAS job for this client", new_admin_bas_job_path(bas_client_id: @client.id), class: "btn-secondary" %>
    <%= link_to "Back to BAS workspace", admin_bas_root_path, class: "btn-secondary" %>
  </div>
</section>

<section class="admin-card-panel">
  <h2>Client details</h2>
  <dl class="admin-asset-details">
    <div>
      <dt>Legal name</dt>
      <dd><%= @client.legal_name %></dd>
    </div>
    <div>
      <dt>Trading name</dt>
      <dd><%= @client.trading_name.presence || "Not recorded" %></dd>
    </div>
    <div>
      <dt>Industry</dt>
      <dd><%= @client.industry_label %></dd>
    </div>
    <div>
      <dt>ABN</dt>
      <dd><%= @client.abn.presence || "Not recorded" %></dd>
    </div>
    <div>
      <dt>Contact name</dt>
      <dd><%= @client.contact_name.presence || "Not recorded" %></dd>
    </div>
    <div>
      <dt>Contact email</dt>
      <dd><%= @client.contact_email.presence || "Not recorded" %></dd>
    </div>
    <div>
      <dt>Contact phone</dt>
      <dd><%= @client.contact_phone.presence || "Not recorded" %></dd>
    </div>
    <div>
      <dt>Default GST basis</dt>
      <dd><%= @client.default_gst_basis == "unknown" ? "Not set" : @client.default_gst_basis.humanize %></dd>
    </div>
    <div>
      <dt>Reporting frequency</dt>
      <dd><%= @client.reporting_frequency.humanize %></dd>
    </div>
    <div>
      <dt>Default reporting method</dt>
      <dd><%= @client.default_reporting_method == "unknown" ? "Not set" : @client.default_reporting_method.humanize %></dd>
    </div>
    <div>
      <dt>Notes / internal notes</dt>
      <dd><%= simple_format(@client.notes.presence || "Not recorded") %></dd>
    </div>
    <div>
      <dt>Created</dt>
      <dd><%= l(@client.created_at, format: :short) %></dd>
    </div>
    <div>
      <dt>Updated</dt>
      <dd><%= l(@client.updated_at, format: :short) %></dd>
    </div>
  </dl>
</section>

<section class="admin-card-panel">
  <div class="admin-panel-heading">
    <h2>Related BAS jobs</h2>
    <div class="admin-actions">
      <%= link_to "New TDK BAS job for this client", new_admin_bas_job_path(bas_client_id: @client.id, workflow_type: "tdk_group"), class: "text-link" %>
      <%= link_to "New standard BAS job for this client", new_admin_bas_job_path(bas_client_id: @client.id), class: "text-link" %>
    </div>
  </div>

  <% if @jobs.any? %>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Quarter</th>
            <th>Period</th>
            <th>Status</th>
            <th>Workflow</th>
            <th>GST basis / reporting method</th>
            <th>Updated</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @jobs.each do |job| %>
            <tr>
              <td><%= link_to job.period_label, admin_bas_job_path(job), class: "text-link" %></td>
              <td><%= job.period_start.to_fs(:db) %> to <%= job.period_end.to_fs(:db) %></td>
              <td><%= job.status.humanize %></td>
              <td><%= job.workflow_type_label %></td>
              <td><%= job.gst_basis.humanize %> / <%= job.reporting_method.humanize %></td>
              <td><%= l(job.updated_at, format: :short) %></td>
              <td><%= link_to "Open job", admin_bas_job_path(job), class: "text-link" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="admin-muted">No BAS jobs for this client yet.</p>
  <% end %>
</section>

<section class="admin-card-panel">
  <div class="admin-panel-heading">
    <h2>Danger zone</h2>
  </div>

  <% if @client.cleanup_deletable? %>
    <p class="admin-muted">Delete this BAS client record.</p>
    <%= button_to "Delete client",
          admin_bas_client_path(@client),
          method: :delete,
          class: "text-danger",
          form: bas_submit_guard_form("Deleting", data: { turbo_confirm: "Delete this BAS client? This cannot be undone." }) %>
  <% else %>
    <p class="admin-muted"><%= BasClient::CLEANUP_DELETE_BLOCKED_MESSAGE %></p>
  <% end %>
</section>
