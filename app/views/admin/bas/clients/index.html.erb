<section class="admin-page-heading">
  <div>
    <p class="eyebrow">BAS</p>
    <h1>Clients</h1>
  </div>
  <div class="admin-actions">
    <%= link_to "New client", new_admin_bas_client_path, class: "btn-primary" %>
    <%= link_to "Back to BAS workspace", admin_bas_root_path, class: "btn-secondary" %>
  </div>
</section>

<div class="admin-table-wrap">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Legal name</th>
        <th>Trading name</th>
        <th>Industry</th>
        <th>ABN</th>
        <th>Contact email</th>
        <th>Jobs</th>
        <th>Status</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @clients.each do |client| %>
        <tr>
          <td><%= link_to client.legal_name, admin_bas_client_path(client), class: "text-link" %></td>
          <td><%= client.trading_name.presence || "Not recorded" %></td>
          <td><%= client.industry_label %></td>
          <td><%= client.abn.presence || "Not recorded" %></td>
          <td><%= client.contact_email.presence || "Not recorded" %></td>
          <td><%= client.bas_jobs.size %></td>
          <td><%= client.archived? ? "Archived" : "Active" %></td>
          <td>
            <%= link_to "Open", admin_bas_client_path(client), class: "text-link" %><br>
            <%= link_to "Edit", edit_admin_bas_client_path(client), class: "text-link" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
