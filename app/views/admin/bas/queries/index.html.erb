<section class="admin-page-heading">
  <div>
    <p class="eyebrow">BAS queries</p>
    <h1>Client/internal queries</h1>
    <p>Client: <%= bas_client_heading_name(@job.bas_client) %></p>
    <%= bas_job_heading_metadata(@job) %>
  </div>
  <div class="admin-actions">
    <%= link_to "Add query", new_admin_bas_job_query_path(@job), class: "btn-primary" %>
    <%= link_to "Back to job", admin_bas_job_path(@job), class: "btn-secondary" %>
  </div>
</section>

<div class="admin-table-wrap">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Query</th>
        <th>Source</th>
        <th>Amount</th>
        <th>Status</th>
        <th>Updated by</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @queries.each do |query| %>
        <tr>
          <td><%= query.query_type.humanize %></td>
          <td><%= query.source_summary.presence || query.display_title %></td>
          <td><%= number_to_currency(query.source_amount) if query.source_amount.present? %></td>
          <td><%= query.status.humanize %></td>
          <td><%= query.updated_by.presence || "Not recorded" %></td>
          <td><%= link_to "Review query", edit_admin_bas_job_query_path(@job, query), class: "text-link" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
