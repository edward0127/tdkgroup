<section class="admin-page-heading">
  <div>
    <p class="eyebrow">BAS query</p>
    <h1><%= @query.title %></h1>
    <p><%= @job.bas_client.display_name %> - <%= @job.period_label %></p>
  </div>
  <div class="admin-actions">
    <%= link_to "Edit query", edit_admin_bas_job_query_path(@job, @query), class: "btn-primary" %>
    <%= link_to "Back to job", admin_bas_job_path(@job), class: "btn-secondary" %>
  </div>
</section>

<section class="admin-card-panel">
  <h2>Query details</h2>
  <dl class="admin-asset-details">
    <div>
      <dt>Type</dt>
      <dd><%= @query.query_type.humanize %></dd>
    </div>
    <div>
      <dt>Status</dt>
      <dd><%= @query.status.humanize %></dd>
    </div>
    <div>
      <dt>Details</dt>
      <dd><%= simple_format(@query.details.presence || "None") %></dd>
    </div>
    <div>
      <dt>Resolution notes</dt>
      <dd><%= simple_format(@query.resolution_notes.presence || "None") %></dd>
    </div>
  </dl>
</section>
