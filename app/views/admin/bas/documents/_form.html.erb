<% if document.errors.any? %>
  <div class="form-errors">
    <ul>
      <% document.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: document,
      url: admin_bas_job_documents_path(job),
      class: "admin-form",
      multipart: true do |form| %>
  <section class="admin-card-panel">
    <h2>Document details</h2>
    <div class="admin-form-grid">
      <div class="field">
        <%= form.label :title %>
        <%= form.text_field :title, required: true %>
      </div>
      <div class="field">
        <%= form.label :document_type %>
        <%= form.select :document_type, BasDocument::DOCUMENT_TYPE_VALUES.map { |value| [ value.humanize, value ] } %>
      </div>
      <div class="field">
        <%= form.label :file %>
        <%= form.file_field :file, accept: BasDocument::ACCEPT_ATTRIBUTE, required: true %>
      </div>
    </div>
    <div class="field">
      <%= form.label :notes %>
      <%= form.text_area :notes, rows: 5 %>
    </div>
  </section>

  <div class="admin-submit-row">
    <button type="submit" class="btn-primary">Upload document</button>
  </div>
<% end %>
