<% totals = @calculation.totals %>
<% summary = totals.fetch("summary", {}) %>
<% labels = summary.fetch("bas_labels", {}) %>
<% payroll = totals.fetch("payroll", {}) %>

<section class="admin-page-heading">
  <div>
    <p class="eyebrow">BAS report review</p>
    <h1><%= @job.bas_client.display_name %></h1>
    <p><%= @job.period_label %></p>
  </div>
  <div class="admin-actions">
    <% unless @job.locked? %>
      <%= button_to "Calculate draft", calculate_admin_bas_job_report_path(@job), method: :post, class: "btn-primary" %>
      <%= link_to "Add adjustment", new_admin_bas_job_adjustment_path(@job), class: "btn-secondary" %>
    <% end %>
    <%= link_to "Snapshots", admin_bas_job_report_snapshots_path(@job), class: "btn-secondary" %>
    <%= link_to "Back to job", admin_bas_job_path(@job), class: "btn-secondary" %>
  </div>
</section>

<section class="admin-card-panel">
  <h2>BAS summary</h2>
  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Label</th>
          <th>Exact amount</th>
          <th>BAS whole-dollar suggestion</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>G1 total sales</td>
          <td><%= number_to_currency(summary["g1_total_sales"]) %></td>
          <td><%= labels["G1"] %></td>
        </tr>
        <tr>
          <td>1A GST on sales</td>
          <td><%= number_to_currency(summary["gst_on_sales_1a"]) %></td>
          <td><%= labels["1A"] %></td>
        </tr>
        <tr>
          <td>1B GST on purchases</td>
          <td><%= number_to_currency(summary["gst_on_purchases_1b"]) %></td>
          <td><%= labels["1B"] %></td>
        </tr>
        <tr>
          <td>Net GST payable/refundable</td>
          <td><%= number_to_currency(summary["net_gst_payable"]) %></td>
          <td><%= labels["net_gst_payable"] %></td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<section class="admin-card-panel">
  <div class="admin-panel-heading">
    <h2>Latest snapshot</h2>
    <% if @latest_snapshot %>
      <%= link_to "Open snapshot", admin_bas_job_report_snapshot_path(@job, @latest_snapshot), class: "text-link" %>
    <% end %>
  </div>
  <% if @latest_snapshot %>
    <dl class="admin-asset-details">
      <div>
        <dt>Status</dt>
        <dd><%= @latest_snapshot.status.humanize %></dd>
      </div>
      <div>
        <dt>Generated</dt>
        <dd><%= @latest_snapshot.generated_at ? l(@latest_snapshot.generated_at, format: :short) : "Not recorded" %></dd>
      </div>
      <div>
        <dt>Blockers</dt>
        <dd><%= @latest_snapshot.validation_errors.size %></dd>
      </div>
    </dl>
  <% else %>
    <p class="admin-muted">No report snapshot has been generated.</p>
  <% end %>
</section>

<section class="admin-card-panel">
  <h2>Approval blockers</h2>
  <% if @approval_blockers.any? %>
    <ul>
      <% @approval_blockers.each do |blocker| %>
        <li><%= blocker %></li>
      <% end %>
    </ul>
  <% else %>
    <p class="admin-muted">No approval blockers found.</p>
  <% end %>
</section>

<section class="admin-card-panel">
  <h2>Payroll</h2>
  <div class="admin-table-wrap">
    <table class="admin-table">
      <tbody>
        <tr>
          <th>Gross wages</th>
          <td><%= number_to_currency(payroll["gross_wages"]) %></td>
        </tr>
        <tr>
          <th>PAYG withheld</th>
          <td><%= number_to_currency(payroll["payg_withheld"]) %></td>
        </tr>
        <tr>
          <th>Super amount</th>
          <td><%= number_to_currency(payroll["super_amount"]) %></td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<section class="admin-card-panel">
  <div class="admin-panel-heading">
    <h2>Manual adjustments</h2>
    <%= link_to "View all", admin_bas_job_adjustments_path(@job), class: "text-link" %>
  </div>
  <% if @adjustments.any? %>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Type</th>
            <th>Label</th>
            <th>Amount</th>
            <th>Reason</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @adjustments.each do |adjustment| %>
            <tr>
              <td><%= adjustment.adjustment_type.humanize %></td>
              <td><%= adjustment.label %></td>
              <td><%= number_to_currency(adjustment.amount) %></td>
              <td><%= adjustment.reason %></td>
              <td><%= link_to "Edit", edit_admin_bas_job_adjustment_path(@job, adjustment), class: "text-link" unless @job.locked? %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="admin-muted">No manual adjustments.</p>
  <% end %>
</section>

<section class="admin-card-panel">
  <h2>GST detail</h2>
  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Section</th>
          <th>Date</th>
          <th>Party</th>
          <th>GST code</th>
          <th>Total</th>
          <th>GST</th>
        </tr>
      </thead>
      <tbody>
        <% (Array(totals["gst_sales_detail"]).map { |row| [ "Sales", row ] } + Array(totals["gst_purchase_detail"]).map { |row| [ "Purchases", row ] } + Array(totals["cash_transaction_detail"]).map { |row| [ "Cash", row ] }).each do |section, row| %>
          <tr>
            <td><%= section %></td>
            <td><%= row["date"] %></td>
            <td><%= row["party"] %></td>
            <td><%= row["gst_code"] %></td>
            <td><%= number_to_currency(row["total_amount"]) %></td>
            <td><%= number_to_currency(row["gst_amount"]) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

<section class="admin-card-panel">
  <h2>Review summaries</h2>
  <div class="admin-table-wrap">
    <table class="admin-table">
      <tbody>
        <tr>
          <th>Accepted matches</th>
          <td><%= @accepted_matches.count %></td>
        </tr>
        <tr>
          <th>Open queries</th>
          <td><%= @open_queries.count %></td>
        </tr>
        <tr>
          <th>Ignored/excluded items</th>
          <td><%= Array(totals["ignored_items"]).size %></td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<section class="admin-card-panel">
  <h2>Recent audit events</h2>
  <% if @audit_events.any? %>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Event</th>
            <th>Actor</th>
            <th>Created</th>
          </tr>
        </thead>
        <tbody>
          <% @audit_events.each do |event| %>
            <tr>
              <td><%= event.event_type.humanize %></td>
              <td><%= event.actor_username.presence || "Not recorded" %></td>
              <td><%= l(event.created_at, format: :short) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="admin-muted">No audit events yet.</p>
  <% end %>
</section>
