<section class="admin-page-heading">
  <div>
    <p class="eyebrow">BAS bank transaction</p>
    <h1><%= @bank_transaction.reference.presence || "Bank transaction ##{@bank_transaction.id}" %></h1>
    <p><%= @job.bas_client.display_name %> - <%= @job.period_label %></p>
  </div>
  <div class="admin-actions">
    <%= link_to "All bank transactions", admin_bas_job_bank_transactions_path(@job), class: "btn-secondary" %>
    <%= link_to "Back to job", admin_bas_job_path(@job), class: "btn-secondary" %>
  </div>
</section>

<section class="admin-card-panel">
  <h2>Bank transaction details</h2>
  <dl class="admin-asset-details">
    <div>
      <dt>Date</dt>
      <dd><%= @bank_transaction.transaction_date || "Not recorded" %></dd>
    </div>
    <div>
      <dt>Description</dt>
      <dd><%= @bank_transaction.description.presence || @bank_transaction.details.presence || "Not recorded" %></dd>
    </div>
    <div>
      <dt>Reference</dt>
      <dd><%= @bank_transaction.reference.presence || "Not recorded" %></dd>
    </div>
    <div>
      <dt>Debit</dt>
      <dd><%= number_to_currency(@bank_transaction.debit) if @bank_transaction.debit.present? %></dd>
    </div>
    <div>
      <dt>Credit</dt>
      <dd><%= number_to_currency(@bank_transaction.credit) if @bank_transaction.credit.present? %></dd>
    </div>
    <div>
      <dt>Amount</dt>
      <dd><%= number_to_currency(@bank_transaction.amount) if @bank_transaction.amount.present? %></dd>
    </div>
    <div>
      <dt>Status</dt>
      <dd><%= @bank_transaction.status.humanize %></dd>
    </div>
  </dl>
</section>

<%= render "admin/bas/shared/source_matches_and_queries", job: @job, matches: @matches, queries: @queries %>
