<section class="admin-page-heading">
  <div>
    <p class="eyebrow">BAS records</p>
    <h1>Bank transactions</h1>
    <p><%= @job.bas_client.display_name %> - <%= @job.period_label %></p>
  </div>
  <%= link_to "Back to job", admin_bas_job_path(@job), class: "btn-secondary" %>
</section>

<section class="admin-card-panel">
  <%= form_with url: admin_bas_job_bank_transactions_path(@job), method: :get, class: "admin-form" do %>
    <div class="admin-form-grid">
      <div class="field">
        <%= label_tag :status %>
        <%= select_tag :status, options_for_select([ [ "Any", "" ] ] + BasBankTransaction::STATUS_VALUES.map { |value| [ value.humanize, value ] }, params[:status]) %>
      </div>
      <div class="field">
        <%= label_tag :q, "Description/reference" %>
        <%= text_field_tag :q, params[:q] %>
      </div>
      <div class="field">
        <%= label_tag :start_date %>
        <%= date_field_tag :start_date, params[:start_date] %>
      </div>
      <div class="field">
        <%= label_tag :end_date %>
        <%= date_field_tag :end_date, params[:end_date] %>
      </div>
      <div class="field">
        <%= label_tag :import_run_id, "Import run" %>
        <%= select_tag :import_run_id, options_for_select([ [ "Any", "" ] ] + @import_runs.map { |run| [ "##{run.id} #{run.import_type.humanize}", run.id ] }, params[:import_run_id]) %>
      </div>
    </div>
    <button type="submit" class="btn-secondary">Filter</button>
  <% end %>
</section>

<div class="admin-table-wrap">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Date</th>
        <th>Description</th>
        <th>Reference</th>
        <th>Debit</th>
        <th>Credit</th>
        <th>Amount</th>
        <th>Status</th>
        <th>Matches</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @bank_transactions.each do |transaction| %>
        <tr>
          <td><%= transaction.transaction_date %></td>
          <td><%= transaction.description.presence || transaction.details %></td>
          <td><%= transaction.reference %></td>
          <td><%= number_to_currency(transaction.debit) if transaction.debit.present? %></td>
          <td><%= number_to_currency(transaction.credit) if transaction.credit.present? %></td>
          <td><%= number_to_currency(transaction.amount) if transaction.amount.present? %></td>
          <td><%= transaction.status.humanize %></td>
          <td><%= transaction.matches.proposed.count %> proposed</td>
          <td>
            <%= link_to "Open", admin_bas_job_bank_transaction_path(@job, transaction), class: "text-link" %>
            <% unless @job.locked? %>
              <% if transaction.status == "ignored" %>
                <%= button_to "Restore",
                      restore_admin_bas_job_bank_transaction_path(@job, transaction),
                      method: :post,
                      class: "text-link",
                      form: bas_submit_guard_form("Restoring") %>
              <% else %>
                <%= button_to "Ignore",
                      ignore_admin_bas_job_bank_transaction_path(@job, transaction),
                      method: :post,
                      class: "text-danger",
                      form: bas_submit_guard_form("Ignoring") %>
                <%= button_to "Needs review",
                      mark_needs_review_admin_bas_job_bank_transaction_path(@job, transaction),
                      method: :post,
                      class: "text-link",
                      form: bas_submit_guard_form("Marking review") %>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
