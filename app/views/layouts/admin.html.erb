<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= tdk_t("admin.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="admin-body">
    <header class="admin-topbar">
      <%= link_to admin_root_path, class: "admin-brand" do %>
        <%= image_tag "tdk/tdk-logo.jpg", alt: "TDK Group Pty Ltd", class: "admin-brand__logo" %>
        <span>TDK Admin</span>
      <% end %>
      <nav class="admin-nav">
        <%= link_to "Pages", admin_cms_pages_path %>
        <%= link_to "Assets", admin_cms_assets_path %>
        <%= link_to "BAS", admin_bas_root_path %>
        <%= link_to "New TDK BAS", new_admin_bas_job_path(workflow_type: "tdk_group") %>
        <%= link_to "Public site", root_path %>
        <%= button_to "Logout", admin_logout_path, method: :delete, class: "admin-logout" %>
      </nav>
    </header>
    <%= render "shared/flash" %>
    <main class="admin-main">
      <%= yield %>
    </main>
  </body>
</html>
