<% hero = @content.fetch("hero", {}) %>
<% sections = Array(@content["sections"]) %>
<% hero_image_key = hero["image_key"].presence || hero_asset_key %>

<section class="hero-section <%= page_template_class %>">
  <div class="hero-section__content">
    <% if hero["eyebrow"].present? || (cms_inline_editing? && hero.key?("eyebrow")) %>
      <p class="eyebrow"><%= cms_edit_field("hero.eyebrow", hero["eyebrow"], label: "Hero eyebrow") %></p>
    <% end %>
    <h1><%= cms_edit_field("hero.title", hero["title"].presence || @translation.title, label: "Hero title", multiline: true, rows: 2) %></h1>
    <p class="hero-lead"><%= cms_edit_field("hero.lead", hero["lead"], label: "Hero lead", multiline: true, rows: 3) %></p>
    <% if hero["primary_label"].present? || hero["secondary_label"].present? %>
      <div class="hero-actions">
        <% if cms_inline_editing? %>
          <% if hero["primary_label"].present? %>
            <%= cms_edit_field("hero.primary_label", hero["primary_label"], label: "Primary CTA label") %>
          <% end %>
          <% if hero["secondary_label"].present? %>
            <%= cms_edit_field("hero.secondary_label", hero["secondary_label"], label: "Secondary CTA label") %>
          <% end %>
        <% else %>
          <% if hero["primary_label"].present? %>
            <%= link_to hero["primary_label"], localized_slug_path(hero["primary_slug"]), class: "btn-primary" %>
          <% end %>
          <% if hero["secondary_label"].present? %>
            <%= link_to hero["secondary_label"], localized_slug_path(hero["secondary_slug"]), class: "btn-secondary" %>
          <% end %>
        <% end %>
      </div>
    <% end %>
    <div class="hero-proof">
      <span><%= current_locale == "zh" ? "CPA 执业支持" : "CPA practice" %></span>
      <span><%= current_locale == "zh" ? "注册税务代理" : "Registered tax agent" %></span>
      <span><%= current_locale == "zh" ? "中英双语服务" : "English and Chinese support" %></span>
    </div>
  </div>

  <aside class="hero-media" aria-label="TDK Group professional services">
    <div class="hero-media__image-wrap">
      <%= cms_asset_image_tag(hero_image_key, fallback: hero_asset_fallback, class: "hero-media__image") %>
      <div class="hero-media__overlay">
        <span><%= current_locale == "zh" ? "专业服务" : "Professional services" %></span>
        <strong><%= current_locale == "zh" ? "税务 · 会计 · 咨询" : "Tax · Accounting · Advisory" %></strong>
      </div>
    </div>
    <%= cms_edit_image_picker("hero.image_key", hero_image_key, label: "Hero image") %>
    <% if hero["stats"].present? %>
      <div class="hero-stats">
        <% Array(hero["stats"]).each_with_index do |stat, index| %>
          <div>
            <strong><%= cms_edit_field("hero.stats.#{index}.value", stat["value"], label: "Stat value") %></strong>
            <span><%= cms_edit_field("hero.stats.#{index}.label", stat["label"], label: "Stat label") %></span>
          </div>
        <% end %>
      </div>
    <% end %>
    <div class="credential-card">
      <span>CPA</span>
      <strong><%= current_locale == "zh" ? "专业标准与客户保密" : "Professional standards and confidentiality" %></strong>
      <p><%= current_locale == "zh" ? "面向个人、企业和投资者的务实会计与税务支持。" : "Practical accounting and tax support for individuals, businesses and investors." %></p>
    </div>
  </aside>
</section>

<% sections.each_with_index do |block, section_index| %>
  <%= render "pages/content_block", block: block, section_index: section_index %>
<% end %>

<% if @page.slug == "contact-us" %>
  <%= render "pages/location_map" %>
  <%= render "pages/contact_form", contact_form: @contact_form unless cms_inline_editing? %>
<% end %>
