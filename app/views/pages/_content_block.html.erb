<% kind = block["kind"].to_s %>
<% section_index ||= 0 %>

<% case kind %>
<% when "prose" %>
  <section class="content-section content-section--prose">
    <% if block["title"].present? || block["eyebrow"].present? %>
      <div class="section-heading">
        <% if block["eyebrow"].present? %>
          <p class="eyebrow"><%= cms_edit_field("sections.#{section_index}.eyebrow", block["eyebrow"], label: "Section eyebrow") %></p>
        <% end %>
        <% if block["title"].present? %>
          <h2><%= cms_edit_field("sections.#{section_index}.title", block["title"], label: "Section heading", multiline: true, rows: 2) %></h2>
        <% end %>
      </div>
    <% end %>
    <div class="prose-panel prose-panel--wide">
      <% if block["body"].present? %>
        <% block_paragraphs(block).each_with_index do |paragraph, paragraph_index| %>
          <% body_path = block["body"].is_a?(Array) ? "sections.#{section_index}.body.#{paragraph_index}" : "sections.#{section_index}.body" %>
          <p><%= cms_edit_field(body_path, paragraph, label: "Paragraph", multiline: true, rows: 4) %></p>
        <% end %>
      <% end %>
      <% if Array(block["bullets"]).present? %>
        <ul class="prose-list">
          <% Array(block["bullets"]).each_with_index do |bullet, bullet_index| %>
            <li><%= cms_edit_field("sections.#{section_index}.bullets.#{bullet_index}", bullet, label: "Bullet") %></li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </section>
<% when "intro" %>
  <% intro_image_key = block["image_key"].presence || hero_asset_key %>
  <section class="content-section content-section--intro">
    <div class="intro-layout">
      <div>
        <div class="section-heading">
          <% if block["eyebrow"].present? %>
            <p class="eyebrow"><%= cms_edit_field("sections.#{section_index}.eyebrow", block["eyebrow"], label: "Section eyebrow") %></p>
          <% end %>
          <h2><%= cms_edit_field("sections.#{section_index}.title", block["title"], label: "Section heading", multiline: true, rows: 2) %></h2>
        </div>
        <div class="prose-panel">
          <% block_paragraphs(block).each_with_index do |paragraph, paragraph_index| %>
            <% body_path = block["body"].is_a?(Array) ? "sections.#{section_index}.body.#{paragraph_index}" : "sections.#{section_index}.body" %>
            <p><%= cms_edit_field(body_path, paragraph, label: "Paragraph", multiline: true, rows: 4) %></p>
          <% end %>
        </div>
      </div>
      <figure class="section-image-card">
        <%= cms_asset_image_tag(intro_image_key, fallback: hero_asset_fallback, class: "section-image-card__image") %>
      </figure>
      <%= cms_edit_image_picker("sections.#{section_index}.image_key", intro_image_key, label: "Section image") %>
    </div>
  </section>
<% when "cards" %>
  <section class="content-section content-section--tinted">
    <div class="section-heading">
      <% if block["eyebrow"].present? %>
        <p class="eyebrow"><%= cms_edit_field("sections.#{section_index}.eyebrow", block["eyebrow"], label: "Section eyebrow") %></p>
      <% end %>
      <h2><%= cms_edit_field("sections.#{section_index}.title", block["title"], label: "Section heading", multiline: true, rows: 2) %></h2>
      <% if block["body"].present? %>
        <% block_paragraphs(block).each_with_index do |paragraph, paragraph_index| %>
          <% body_path = block["body"].is_a?(Array) ? "sections.#{section_index}.body.#{paragraph_index}" : "sections.#{section_index}.body" %>
          <p><%= cms_edit_field(body_path, paragraph, label: "Paragraph", multiline: true, rows: 4) %></p>
        <% end %>
      <% end %>
    </div>
    <div class="service-grid">
      <% Array(block["items"]).each_with_index do |item, item_index| %>
        <article class="service-card">
          <div class="service-card__media">
            <% asset_key = item["image_key"].presence || service_asset_key(item) %>
            <%= cms_asset_image_tag(asset_key, fallback: service_asset_fallback(asset_key), class: "service-card__image") %>
          </div>
          <%= cms_edit_image_picker("sections.#{section_index}.items.#{item_index}.image_key", asset_key, label: "Card image") %>
          <h3><%= cms_edit_field("sections.#{section_index}.items.#{item_index}.title", item["title"], label: "Card title", multiline: true, rows: 2) %></h3>
          <% if item["body"].present? || cms_inline_editing? %>
            <p><%= cms_edit_field("sections.#{section_index}.items.#{item_index}.body", item["body"], label: "Card body", multiline: true, rows: 4) %></p>
          <% end %>
          <% if item["slug"].present? %>
            <%= link_to current_locale == "zh" ? "了解更多" : "Learn more", localized_slug_path(item["slug"]), class: "text-link service-card__link" %>
          <% end %>
        </article>
      <% end %>
    </div>
  </section>
<% when "split" %>
  <section class="split-section">
    <div class="split-section__copy">
      <% if block["eyebrow"].present? %>
        <p class="eyebrow"><%= cms_edit_field("sections.#{section_index}.eyebrow", block["eyebrow"], label: "Section eyebrow") %></p>
      <% end %>
      <h2><%= cms_edit_field("sections.#{section_index}.title", block["title"], label: "Section heading", multiline: true, rows: 2) %></h2>
      <% block_paragraphs(block).each_with_index do |paragraph, paragraph_index| %>
        <% body_path = block["body"].is_a?(Array) ? "sections.#{section_index}.body.#{paragraph_index}" : "sections.#{section_index}.body" %>
        <p><%= cms_edit_field(body_path, paragraph, label: "Paragraph", multiline: true, rows: 4) %></p>
      <% end %>
    </div>
    <ul class="check-list">
      <% Array(block["bullets"]).each_with_index do |bullet, bullet_index| %>
        <li><%= cms_edit_field("sections.#{section_index}.bullets.#{bullet_index}", bullet, label: "Bullet") %></li>
      <% end %>
    </ul>
    <div class="split-section__visual">
      <span>CPA</span>
      <strong><%= current_locale == "zh" ? "可靠的专业判断" : "Reliable professional judgement" %></strong>
      <p><%= current_locale == "zh" ? "我们以清晰沟通、合规意识和长期客户关系为基础提供服务。" : "Advice is grounded in clear communication, compliance discipline and long-term client relationships." %></p>
    </div>
  </section>
<% when "profile" %>
  <% profile_image_key = block["image_key"].presence || "business-advisory" %>
  <section class="content-section">
    <article class="profile-card">
      <div>
        <div class="profile-card__avatar">
          <%= cms_asset_image_tag(profile_image_key, fallback: "tdk/business-advisory.jpg", class: "profile-card__image") %>
        </div>
        <%= cms_edit_image_picker("sections.#{section_index}.image_key", profile_image_key, label: "Profile image") %>
      </div>
      <div>
        <h2><%= cms_edit_field("sections.#{section_index}.title", block["title"], label: "Profile name") %></h2>
        <p class="profile-card__subtitle"><%= cms_edit_field("sections.#{section_index}.subtitle", block["subtitle"], label: "Profile subtitle", multiline: true, rows: 2) %></p>
        <% block_paragraphs(block).each_with_index do |paragraph, paragraph_index| %>
          <% body_path = block["body"].is_a?(Array) ? "sections.#{section_index}.body.#{paragraph_index}" : "sections.#{section_index}.body" %>
          <p><%= cms_edit_field(body_path, paragraph, label: "Profile paragraph", multiline: true, rows: 4) %></p>
        <% end %>
        <% if block["contact"].present? %>
          <p>
            <% if cms_inline_editing? %>
              <%= cms_edit_field("sections.#{section_index}.contact", block["contact"], label: "Profile contact") %>
            <% else %>
              <%= mail_to block["contact"] %>
            <% end %>
          </p>
        <% end %>
      </div>
    </article>
  </section>
<% when "contact" %>
  <% contact_image_key = block["image_key"].presence || "office-documents" %>
  <section class="content-section">
    <div class="contact-details">
      <div class="section-heading">
        <p class="eyebrow">TDK Group</p>
        <h2><%= cms_edit_field("sections.#{section_index}.title", block["title"], label: "Contact heading") %></h2>
      </div>
      <div class="contact-details__grid">
        <dl>
          <% Array(block["details"]).each_with_index do |detail, detail_index| %>
            <div>
              <dt><%= cms_edit_field("sections.#{section_index}.details.#{detail_index}.label", detail["label"], label: "Contact label") %></dt>
              <dd>
                <% if cms_inline_editing? %>
                  <%= cms_edit_field("sections.#{section_index}.details.#{detail_index}.value", detail["value"], label: "Contact value") %>
                <% else %>
                  <%= contact_value_link(detail["value"]) %>
                <% end %>
              </dd>
            </div>
          <% end %>
        </dl>
        <div>
          <figure class="contact-details__image">
            <%= cms_asset_image_tag(contact_image_key, fallback: "tdk/office-documents.jpg", class: "contact-details__photo") %>
          </figure>
          <%= cms_edit_image_picker("sections.#{section_index}.image_key", contact_image_key, label: "Contact image") %>
        </div>
      </div>
    </div>
  </section>
<% when "cta" %>
  <section class="cta-band">
    <div>
      <h2><%= cms_edit_field("sections.#{section_index}.title", block["title"], label: "CTA heading", multiline: true, rows: 2) %></h2>
      <% if block["body"].present? && block["body"] != block["title"] %>
        <p><%= cms_edit_field("sections.#{section_index}.body", block["body"], label: "CTA body", multiline: true, rows: 3) %></p>
      <% end %>
    </div>
    <% if block["slug"].present? %>
      <% if cms_inline_editing? %>
        <%= cms_edit_field("sections.#{section_index}.label", block["label"], label: "CTA label") %>
      <% else %>
        <%= link_to block["label"], localized_slug_path(block["slug"]), class: "btn-primary btn-primary--light" %>
      <% end %>
    <% end %>
  </section>
<% end %>
