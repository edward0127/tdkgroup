RAILS_ENV=production
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=true
APP_HOST=tdkgroup.tudouke.com

# Rails needs a secret key base in production.
# SECRET_KEY_BASE is sufficient for this app's current runtime config.
# RAILS_MASTER_KEY is only required if production needs encrypted credentials.
RAILS_MASTER_KEY=
SECRET_KEY_BASE=

ADMIN_USERNAME=
ADMIN_PASSWORD=

CONTACT_RECIPIENT_EMAIL=

SMTP_ADDRESS=smtp.mailgun.org
SMTP_PORT=587
SMTP_DOMAIN=email.tudouke.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS=true

ACTIVE_STORAGE_SERVICE=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
PUBLIC_UPLOAD_ASSET_HOST=

# Admin-only BAS AI suggestions. Do not commit real API keys.
BAS_AI_ENABLED=false
BAS_AI_PROVIDER=disabled
BAS_AI_MODEL=
BAS_AI_API_KEY=
BAS_AI_MAX_OUTPUT_TOKENS=2000
